// ============================================================================
// COMPLETE PRODUCTION DATABASE SCHEMA – HOTEL MANAGEMENT SOFTWARE
// Architecture: Modular Monolith
// Database: PostgreSQL 16+ (Neon Serverless)
// ORM: Prisma ORM v5.22.0
// Timezone Standard: Asia/Kolkata (IST) – Timestamptz & Date Separated
// ============================================================================

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// ENUMS (12)
// ============================================================================

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum BookingStatus {
  RESERVED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  OTHER
}

enum PaymentType {
  ADVANCE
  PARTIAL
  FINAL
  REFUND
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  RESIGNED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  WEEKLY_OFF
}

enum PayrollStatus {
  DRAFT
  FINALIZED
  PAID
  PARTIALLY_PAID
}

enum AdvanceStatus {
  PENDING
  PARTIALLY_REPAID
  REPAID
  WAIVED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  FINALIZE
  CANCEL
  CORRECTION
}

// ============================================================================
// 1. ADMIN MANAGEMENT (Strict Single-Admin Architecture)
// ============================================================================

model Admin {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String?   @unique
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  isSingleton  Boolean   @unique @default(true) @map("is_singleton")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("admins")
}

// ============================================================================
// 2. GUEST MANAGEMENT & DOCUMENTS
// ============================================================================

model Guest {
  id                    String    @id @default(uuid())
  guestCode             String    @unique @map("guest_code")
  fullName              String    @map("full_name")
  mobileNumber          String    @map("mobile_number")
  alternateMobileNumber String?   @map("alternate_mobile_number")
  email                 String?
  address               String?
  city                  String?
  state                 String?
  postalCode            String?   @map("postal_code")
  country               String    @default("India")
  dateOfBirth           DateTime? @map("date_of_birth") @db.Date
  gender                String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  documents       GuestDocument[]
  primaryBookings Booking[]       @relation("PrimaryGuest")
  stayHistory     BookingGuest[]

  @@index([mobileNumber])
  @@index([fullName])
  @@index([email])
  @@map("guests")
}

model GuestDocument {
  id                    String   @id @default(uuid())
  guestId               String   @map("guest_id")
  documentType          String   @map("document_type")
  documentNumber        String   @map("document_number")
  documentFileReference String   @map("document_file_reference")
  uploadedAt            DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([documentType, documentNumber])
  @@map("guest_documents")
}

// ============================================================================
// 3. ROOM MANAGEMENT & ROOM PRICING
// ============================================================================

model RoomType {
  id                   String   @id @default(uuid())
  name                 String   @unique
  description          String?
  defaultPricePerNight Decimal  @map("default_price_per_night") @db.Decimal(12, 2)
  capacity             Int      @default(2)
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  rooms Room[]

  @@map("room_types")
}

model Room {
  id            String     @id @default(uuid())
  roomNumber    String     @unique @map("room_number")
  roomTypeId    String     @map("room_type_id")
  description   String?
  floor         Int        @default(1)
  pricePerNight Decimal    @map("price_per_night") @db.Decimal(12, 2)
  roomStatus    RoomStatus @default(AVAILABLE) @map("room_status")
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  roomType RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  bookings Booking[]

  @@index([roomStatus])
  @@index([roomTypeId])
  @@index([floor])
  @@map("rooms")
}

// ============================================================================
// 4. BOOKINGS & GUEST STAY MANAGEMENT
// ============================================================================

model Booking {
  id                   String        @id @default(uuid())
  bookingNumber        String        @unique @map("booking_number")
  primaryGuestId       String        @map("primary_guest_id")
  roomId               String        @map("room_id")
  bookingStatus        BookingStatus @default(RESERVED) @map("booking_status")
  checkInDate          DateTime      @map("check_in_date") @db.Date
  checkInTime          String?       @map("check_in_time")
  expectedCheckOutDate DateTime      @map("expected_check_out_date") @db.Date
  expectedCheckOutTime String?       @map("expected_check_out_time")
  actualCheckInAt      DateTime?     @map("actual_check_in_at") @db.Timestamptz(3)
  actualCheckOutAt     DateTime?     @map("actual_check_out_at") @db.Timestamptz(3)
  numberOfNights       Int           @map("number_of_nights")
  numberOfGuests       Int           @default(1) @map("number_of_guests")
  roomRatePerNight     Decimal       @map("room_rate_per_night") @db.Decimal(12, 2)
  advanceAmount        Decimal       @default(0.00) @map("advance_amount") @db.Decimal(12, 2)
  notes                String?
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  primaryGuest  Guest          @relation("PrimaryGuest", fields: [primaryGuestId], references: [id], onDelete: Restrict)
  room          Room           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  bookingGuests BookingGuest[]
  bookingItems  BookingItem[]
  invoices      Invoice[]
  payments      Payment[]

  @@index([primaryGuestId])
  @@index([roomId])
  @@index([bookingStatus])
  @@index([checkInDate, expectedCheckOutDate])
  @@index([roomId, bookingStatus, checkInDate, expectedCheckOutDate])
  @@map("bookings")
}

model BookingGuest {
  id             String   @id @default(uuid())
  bookingId      String   @map("booking_id")
  guestId        String   @map("guest_id")
  isPrimaryGuest Boolean  @default(false) @map("is_primary_guest")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  guest   Guest   @relation(fields: [guestId], references: [id], onDelete: Restrict)

  @@unique([bookingId, guestId])
  @@index([guestId])
  @@map("booking_guests")
}

// ============================================================================
// 5. HOTEL ITEMS, SERVICES & GUEST PURCHASES
// ============================================================================

model ItemCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  items Item[]

  @@map("item_categories")
}

model Item {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  name        String
  description String?
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  category     ItemCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bookingItems BookingItem[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("items")
}

model BookingItem {
  id               String   @id @default(uuid())
  bookingId        String   @map("booking_id")
  itemId           String?  @map("item_id")
  itemNameSnapshot String   @map("item_name_snapshot")
  quantity         Int      @default(1)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalAmount      Decimal  @map("total_amount") @db.Decimal(12, 2)
  purchaseDate     DateTime @map("purchase_date") @db.Date
  purchaseTime     String?  @map("purchase_time")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  item    Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([itemId])
  @@index([purchaseDate])
  @@map("booking_items")
}

// ============================================================================
// 6. BILLING AND INVOICES
// ============================================================================

model Invoice {
  id                String        @id @default(uuid())
  invoiceNumber     String        @unique @map("invoice_number")
  bookingId         String        @map("booking_id")
  invoiceStatus     InvoiceStatus @default(DRAFT) @map("invoice_status")
  roomCharges       Decimal       @map("room_charges") @db.Decimal(12, 2)
  additionalCharges Decimal       @default(0.00) @map("additional_charges") @db.Decimal(12, 2)
  subtotal          Decimal       @db.Decimal(12, 2)
  discountType      DiscountType? @map("discount_type")
  discountValue     Decimal       @default(0.00) @map("discount_value") @db.Decimal(12, 2)
  discountAmount    Decimal       @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  taxPercentage     Decimal       @default(0.00) @map("tax_percentage") @db.Decimal(5, 2)
  taxAmount         Decimal       @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount       Decimal       @map("total_amount") @db.Decimal(12, 2)
  totalPaid         Decimal       @default(0.00) @map("total_paid") @db.Decimal(12, 2)
  balanceAmount     Decimal       @map("balance_amount") @db.Decimal(12, 2)
  invoiceDate       DateTime      @map("invoice_date") @db.Date
  finalizedAt       DateTime?     @map("finalized_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  booking  Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([bookingId])
  @@index([invoiceStatus])
  @@index([invoiceDate])
  @@map("invoices")
}

// ============================================================================
// 7. PAYMENT MANAGEMENT
// ============================================================================

model Payment {
  id                   String        @id @default(uuid())
  paymentReference     String        @unique @map("payment_reference")
  bookingId            String        @map("booking_id")
  invoiceId            String?       @map("invoice_id")
  paymentType          PaymentType   @map("payment_type")
  paymentMethod        PaymentMethod @map("payment_method")
  amount               Decimal       @db.Decimal(12, 2)
  transactionReference String?       @map("transaction_reference")
  paymentDate          DateTime      @map("payment_date") @db.Date
  paymentStatus        PaymentStatus @default(COMPLETED) @map("payment_status")
  notes                String?
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([invoiceId])
  @@index([paymentDate])
  @@index([paymentMethod])
  @@index([paymentStatus])
  @@map("payments")
}

// ============================================================================
// 8. STAFF MANAGEMENT
// ============================================================================

model Staff {
  id                    String           @id @default(uuid())
  employeeCode          String           @unique @map("employee_code")
  fullName              String           @map("full_name")
  mobileNumber          String           @map("mobile_number")
  alternateMobileNumber String?          @map("alternate_mobile_number")
  email                 String?
  address               String?
  dateOfBirth           DateTime?        @map("date_of_birth") @db.Date
  emergencyContact      String?          @map("emergency_contact")
  designation           String
  department            String
  joiningDate           DateTime         @map("joining_date") @db.Date
  employmentStatus      EmploymentStatus @default(ACTIVE) @map("employment_status")
  monthlySalary         Decimal          @map("monthly_salary") @db.Decimal(12, 2)
  bankAccountHolder     String?          @map("bank_account_holder")
  bankAccountNumber     String?          @map("bank_account_number")
  bankIfscCode          String?          @map("bank_ifsc_code")
  notes                 String?
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  attendanceRecords Attendance[]
  salaryRecords     SalaryRecord[]
  advances          StaffAdvance[]

  @@index([employmentStatus])
  @@index([department])
  @@index([mobileNumber])
  @@map("staff")
}

// ============================================================================
// 9. STAFF ATTENDANCE
// ============================================================================

model Attendance {
  id               String           @id @default(uuid())
  staffId          String           @map("staff_id")
  attendanceDate   DateTime         @map("attendance_date") @db.Date
  attendanceStatus AttendanceStatus @map("attendance_status")
  checkInTime      String?          @map("check_in_time")
  checkOutTime     String?          @map("check_out_time")
  workingHours     Decimal?         @map("working_hours") @db.Decimal(4, 2)
  overtimeHours    Decimal          @default(0.00) @map("overtime_hours") @db.Decimal(4, 2)
  notes            String?
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@unique([staffId, attendanceDate])
  @@index([attendanceDate])
  @@index([attendanceStatus])
  @@map("attendance")
}

// ============================================================================
// 10. STAFF ADVANCE LEDGER
// ============================================================================

model StaffAdvance {
  id               String        @id @default(uuid())
  staffId          String        @map("staff_id")
  advanceReference String        @unique @map("advance_reference")
  amount           Decimal       @map("amount") @db.Decimal(12, 2)
  advanceDate      DateTime      @map("advance_date") @db.Date
  paymentMethod    PaymentMethod @map("payment_method")
  repaymentStatus  AdvanceStatus @default(PENDING) @map("repayment_status")
  recoveredAmount  Decimal       @default(0.00) @map("recovered_amount") @db.Decimal(12, 2)
  balanceAmount    Decimal       @map("balance_amount") @db.Decimal(12, 2)
  salaryRecordId   String?       @map("salary_record_id")
  notes            String?
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  staff        Staff         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  salaryRecord SalaryRecord? @relation(fields: [salaryRecordId], references: [id], onDelete: SetNull)

  @@index([staffId])
  @@index([advanceDate])
  @@index([repaymentStatus])
  @@map("staff_advances")
}

// ============================================================================
// 11. STAFF SALARY AND PAYROLL
// ============================================================================

model SalaryRecord {
  id                   String        @id @default(uuid())
  staffId              String        @map("staff_id")
  payrollMonth         Int           @map("payroll_month")
  payrollYear          Int           @map("payroll_year")
  monthlyBasicSalary   Decimal       @map("monthly_basic_salary") @db.Decimal(12, 2)
  configuredSalaryDays Int           @default(30) @map("configured_salary_days")
  payableDays          Decimal       @map("payable_days") @db.Decimal(5, 2)
  presentDays          Decimal       @map("present_days") @db.Decimal(5, 2)
  absentDays           Decimal       @default(0.00) @map("absent_days") @db.Decimal(5, 2)
  halfDays             Decimal       @default(0.00) @map("half_days") @db.Decimal(5, 2)
  paidLeaves           Decimal       @default(0.00) @map("paid_leaves") @db.Decimal(5, 2)
  unpaidLeaves         Decimal       @default(0.00) @map("unpaid_leaves") @db.Decimal(5, 2)
  overtimeHours        Decimal       @default(0.00) @map("overtime_hours") @db.Decimal(5, 2)
  overtimeAmount       Decimal       @default(0.00) @map("overtime_amount") @db.Decimal(12, 2)
  grossSalary          Decimal       @map("gross_salary") @db.Decimal(12, 2)
  deductions           Decimal       @default(0.00) @db.Decimal(12, 2)
  advanceDeductions    Decimal       @default(0.00) @map("advance_deductions") @db.Decimal(12, 2)
  netSalary            Decimal       @map("net_salary") @db.Decimal(12, 2)
  totalPaid            Decimal       @default(0.00) @map("total_paid") @db.Decimal(12, 2)
  balanceAmount        Decimal       @default(0.00) @map("balance_amount") @db.Decimal(12, 2)
  payrollStatus        PayrollStatus @default(DRAFT) @map("payroll_status")
  finalizedAt          DateTime?     @map("finalized_at") @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  staff          Staff           @relation(fields: [staffId], references: [id], onDelete: Restrict)
  salaryPayments SalaryPayment[]
  staffAdvances  StaffAdvance[]

  @@unique([staffId, payrollMonth, payrollYear])
  @@index([payrollYear, payrollMonth])
  @@index([payrollStatus])
  @@map("salary_records")
}

model SalaryPayment {
  id                   String        @id @default(uuid())
  salaryRecordId       String        @map("salary_record_id")
  paymentReference     String        @unique @map("payment_reference")
  paymentAmount        Decimal       @map("payment_amount") @db.Decimal(12, 2)
  paymentMethod        PaymentMethod @map("payment_method")
  paymentDate          DateTime      @map("payment_date") @db.Date
  transactionReference String?       @map("transaction_reference")
  notes                String?
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  // Relations
  salaryRecord SalaryRecord @relation(fields: [salaryRecordId], references: [id], onDelete: Restrict)

  @@index([salaryRecordId])
  @@index([paymentDate])
  @@index([paymentMethod])
  @@map("salary_payments")
}

// ============================================================================
// 12. HOTEL EXPENSE MANAGEMENT
// ============================================================================

model ExpenseCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id                   String        @id @default(uuid())
  expenseReference     String        @unique @map("expense_reference")
  expenseCategoryId    String        @map("expense_category_id")
  description          String
  amount               Decimal       @db.Decimal(12, 2)
  paymentMethod        PaymentMethod @map("payment_method")
  paymentDate          DateTime      @map("payment_date") @db.Date
  transactionReference String?       @map("transaction_reference")
  notes                String?
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  category ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Restrict)

  @@index([expenseCategoryId])
  @@index([paymentDate])
  @@index([paymentMethod])
  @@map("expenses")
}

// ============================================================================
// 13. HOTEL SETTINGS (Singleton Pattern)
// ============================================================================

model HotelSetting {
  id                   String   @id @default("default")
  isSingleton          Boolean  @unique @default(true) @map("is_singleton")
  hotelName            String   @default("Grand Horizon Hotel") @map("hotel_name")
  hotelAddress         String?  @map("hotel_address")
  mobileNumber         String?  @map("mobile_number")
  email                String?
  logoFileReference    String?  @map("logo_file_reference")
  currencyCode         String   @default("INR") @map("currency_code")
  timezone             String   @default("Asia/Kolkata")
  defaultCheckInTime   String   @default("12:00 PM") @map("default_check_in_time")
  defaultCheckOutTime  String   @default("11:00 AM") @map("default_check_out_time")
  taxEnabled           Boolean  @default(true) @map("tax_enabled")
  defaultTaxPercentage Decimal  @default(12.00) @map("default_tax_percentage") @db.Decimal(5, 2)
  defaultSalaryDays    Int      @default(30) @map("default_salary_days")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("hotel_settings")
}

// ============================================================================
// 14. AUDIT & RECORD HISTORY
// ============================================================================

model AuditLog {
  id             String      @id @default(uuid())
  entityType     String      @map("entity_type")
  entityId       String      @map("entity_id")
  action         AuditAction
  previousValues Json?       @map("previous_values")
  newValues      Json?       @map("new_values")
  changedAt      DateTime    @default(now()) @map("changed_at") @db.Timestamptz(3)
  description    String?

  @@index([entityType, entityId])
  @@index([action])
  @@index([changedAt])
  @@map("audit_logs")
}

// ============================================================================
// 15. SYSTEM HEALTH (Singleton Automated Infrastructure Probe)
// ============================================================================

model SystemHealth {
  id          String   @id @default("system")
  isSingleton Boolean  @unique @default(true) @map("is_singleton")
  status      String   @default("ok")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_health")
}
