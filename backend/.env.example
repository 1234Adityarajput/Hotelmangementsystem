NODE_ENV=development
PORT=4000

# -----------------------------------------------------------------------------
# NEON POSTGRESQL CONNECTION STRINGS (BACKEND ONLY - NEVER EXPOSE TO FRONTEND)
# -----------------------------------------------------------------------------
# DATABASE_URL: Neon Pooled connection string (used at runtime by Prisma Client)
# Note: Host contains '-pooler'
DATABASE_URL="postgresql://neondb_owner:<ROTATED_PASSWORD>@ep-broad-union-bd9lp850-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL: Neon Direct connection string (used by Prisma migrations)
# Note: Host does NOT contain '-pooler' (obtain directly from Neon dashboard connect settings)
DIRECT_URL="postgresql://neondb_owner:<ROTATED_PASSWORD>@ep-broad-union-bd9lp850.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Security & CORS
JWT_SECRET=development_jwt_secret_key_must_be_at_least_32_characters_long_for_security!
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:3000
